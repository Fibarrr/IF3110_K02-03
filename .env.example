# PostgreSQL lokal
POSTGRES_DB=platform_dev
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
POSTGRES_PORT=5432

# Dipakai backend saat dijalankan langsung dari terminal
DATABASE_URL=postgres://platform:platform_dev_password@localhost:5432/platform_dev?sslmode=disable
BACKEND_PORT=8080

# Isi untuk membuat Platform Admin pertama kali
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# Set true jika koneksi HTTPS berakhir di backend atau reverse proxy
COOKIE_SECURE=false
